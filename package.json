{
  "name": "@camunda8/hub-api",
  "version": "0.0.0-development",
  "description": "TypeScript client for the Camunda Hub REST API (v2)",
  "keywords": [
    "camunda",
    "camunda8",
    "hub",
    "web-modeler",
    "rest-api"
  ],
  "private": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js",
      "require": "./dist/logger.cjs",
      "default": "./dist/logger.js"
    },
    "./fn": {
      "types": "./dist/fn/index.d.ts",
      "import": "./dist/fn/index.js",
      "require": "./dist/fn/index.cjs",
      "default": "./dist/fn/index.js"
    }
  },
  "imports": {
    "#platform": {
      "types": "./dist/runtime/platform/node.d.ts",
      "browser": {
        "import": "./dist/runtime/platform/browser.js",
        "require": "./dist/runtime/platform/browser.cjs"
      },
      "import": "./dist/runtime/platform/node.js",
      "require": "./dist/runtime/platform/node.cjs",
      "default": "./dist/runtime/platform/node.js"
    }
  },
  "author": "josh.wulf@camunda.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camunda/camunda-hub-api-js.git"
  },
  "scripts": {
    "clean": "rimraf dist src/gen",
    "spec:fetch": "tsx scripts/fetch-spec.ts",
    "spec:check": "tsx scripts/fetch-spec.ts --check",
    "generate": "npm run clean && tsx scripts/run-pipeline.ts",
    "version:sync": "tsx scripts/write-version-constant.ts",
    "build": "npm run generate && npm run docs:config && npm run sync-readme:check && npm run format && npm run version:sync && npm run typecheck && npm run bundle && npm run typecheck:dist && node scripts/check-browser-bundle.mjs && node scripts/check-tree-shaking.mjs",
    "bundle": "tsup src/index.ts src/logger.ts src/fn/index.ts src/runtime/platform/node.ts src/runtime/platform/browser.ts --external '#platform' --dts --format esm,cjs --sourcemap --out-dir dist",
    "test": "CAMUNDA_SDK_INTEGRATION=0 vitest run",
    "docs:config": "tsx scripts/generate-config-doc.ts",
    "test:dist": "npm run build --silent && node tests/dist-usage.smoke.mjs",
    "test:cross-runtime": "node scripts/cross-runtime-smoke.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:dist": "tsc --noEmit -p tsconfig.typecheck.dist.json",
    "format": "biome format . --write",
    "format:check": "biome check .",
    "release": "semantic-release",
    "sync-readme": "tsx scripts/sync-readme-snippets.ts",
    "sync-readme:check": "tsx scripts/sync-readme-snippets.ts --check"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "typed-env": "^2.0.0",
    "undici": "^7.30.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@camunda8/sdk-infra": "^1.7.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@types/node": "^22.0.0",
    "camunda-schema-bundler": "2.4.5",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.5",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@semantic-release/github": "^11.0.6",
    "handlebars": "4.7.10",
    "js-yaml@4": "4.3.0",
    "lodash-es@4": "4.18.1",
    "rollup@4": "4.62.3",
    "ajv@8": "8.20.0",
    "glob@10": "10.5.0",
    "postcss@8": "8.5.23",
    "fast-uri@3": "3.1.4",
    "minimatch@9": "9.0.9",
    "picomatch@2": "2.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
