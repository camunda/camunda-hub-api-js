{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@camunda8/hub-api": ["../src/index.ts"],
      "@camunda8/hub-api/fn": ["../src/fn/index.ts"],
      "#platform": ["../src/runtime/platform/node.ts"]
    }
  },
  "include": ["./*.ts"]
}
